DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/token_intelligence
DATABASE_ECHO=false
SALVAR_TEXTO_COMPLETO=false

# Opcional para testes sem persistência. Nunca adicione a chave real ao Git.
OPENAI_ADMIN_API_KEY=

# Obrigatória para criptografar credenciais salvas no PostgreSQL.
# Gere localmente com:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=

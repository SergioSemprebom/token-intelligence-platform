# Modelo de variáveis de ambiente para a stack Docker (Fase 5).
# Copie para .env.docker e ajuste os valores antes de usar:
#
#   cp .env.docker.example .env.docker
#
# .env.docker nunca deve ser commitado (já está listado em .gitignore).
# Não coloque a senha real neste arquivo de exemplo.

# PostgreSQL (container interno da stack, isolado dos containers externos
# my-postgres/my-pgadmin, que não são usados nem alterados por este projeto).
POSTGRES_DB=token_intelligence
POSTGRES_USER=token_app
POSTGRES_PASSWORD=altere_esta_senha

# Porta publicada no host para acessar o PostgreSQL da stack (ex.: psql, DBeaver).
# Mantida diferente de 5432/5433 para não colidir com my-postgres (5433) nem com
# um PostgreSQL local eventualmente rodando na porta padrão.
POSTGRES_HOST_PORT=5434

# Porta publicada no host para acessar a API.
API_HOST_PORT=8000

# Configurações da aplicação (mesmos nomes usados em app/config/settings.py).
DATABASE_ECHO=false
SALVAR_TEXTO_COMPLETO=false

# Modelo de variáveis de ambiente para a stack Docker.
# Copie para .env.docker e ajuste os valores antes de usar:
#
#   cp .env.docker.example .env.docker
#
# .env.docker nunca deve ser commitado.

POSTGRES_DB=token_intelligence
POSTGRES_USER=token_app
POSTGRES_PASSWORD=altere_esta_senha
POSTGRES_HOST_PORT=5434
API_HOST_PORT=8000
DATABASE_ECHO=false
SALVAR_TEXTO_COMPLETO=false

# Gere localmente com:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=cole_a_chave_fernet_aqui
